
# ==========================================
# Python environment and cache
# ==========================================
.venv/
venv/
env/
.runtime/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example

# ESP32-CAM local configuration
esp32_cam/config.h
!esp32_cam/config.h.example
!esp32_cam/config.h.example.*

# ==========================================
# Dataset - raw and processed
# ==========================================
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

# ==========================================
# Legacy YOLO dataset
# ==========================================
dataset/images/**
dataset/labels/**
!dataset/**/.gitkeep
dataset/*.cache

# ==========================================
# Model weights and checkpoints
# ==========================================
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.h5
*.keras
*.safetensors

# ==========================================
# Training and evaluation outputs
# ==========================================
runs/
results/training/**
results/evaluation/**
results/verification/private/**
!results/**/
!results/**/.gitkeep

# ==========================================
# Logs and temporary files
# ==========================================
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Databases and SQLite files
# ==========================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ==========================================
# IDE and editor
# ==========================================
.vscode/
.idea/
*.code-workspace

# ==========================================
# Node.js (if frontend uses Node)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Private baseline review/evaluation images and local source backups
reports/baseline_v1/private/
reports/baseline_v1/*.zip

# Private inference artifacts and every version of local source backups
results/inference/**
results/multi_person/**
reports/**/private/**
reports/**/*.zip

# Selected Lab 2 model artifacts for reproducible local/cloud demos
!models/camera_v7/face_mask_best.pt
!models/cloud_v7/face_mask_v7.onnx
